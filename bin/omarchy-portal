#!/usr/bin/env bash
# Captive portal assistant.
#
# NetworkManager already fetches a known plain-HTTP URL every time you join a
# network, and flips its connectivity state to "portal" when something answers
# with a redirect instead of the expected body. That signal is correct and is
# then dropped on the floor: nothing in the desktop reacts to it.
#
# This finds the actual login URL and opens it. HTTPS is useless for this —
# a portal intercepting an HSTS site gives a TLS error rather than a redirect,
# which is why "the wifi is broken" so often means "nobody showed you the
# login page".
set -uo pipefail

# NetworkManager's own check URL, so we test exactly what it tested.
# Overridable so the detection branches can be exercised without an actual
# hotel between you and the internet.
if [[ -z "${NM_URI:-}" ]]; then
  NM_URI="$(sed -n 's/^uri=//p' /usr/lib/NetworkManager/conf.d/*connectivity*.conf \
            /etc/NetworkManager/conf.d/*.conf 2>/dev/null | head -1)"
fi
: "${NM_URI:=http://ping.archlinux.org/nm-check.txt}"
FALLBACK_URL="http://neverssl.com"   # plain HTTP, no HSTS, always redirectable

state() { nmcli -t networking connectivity 2>/dev/null || echo unknown; }

# A VPN kill switch owning the default route is the one thing that makes a
# captive portal unfixable: the tunnel cannot come up until you log in, and the
# kill switch blocks the login page to stop exactly the kind of leak you now
# need. NetworkManager reports "none" or "limited" rather than "portal",
# because nothing answers at all. Detect it and say so — opening a browser
# here would just show a spinner.
# Are we actually attached to a network? "none" means both "no wifi at all"
# and "joined, but nothing gets out" — only the second is our business.
has_link() {
  nmcli -t -f TYPE,STATE device status 2>/dev/null \
    | grep -qE "^(wifi|ethernet):connected$"
}

killswitch_device() {
  local dev
  dev="$(ip route show default 2>/dev/null | awk '/dev/ {for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' | head -1)"
  case "$dev" in
    pvpnksintrf*|*killswitch*) echo "$dev"; return 0 ;;
  esac
  # Also catch a plain VPN holding the default route with no route to the LAN.
  nmcli -t -f NAME,TYPE connection show --active 2>/dev/null \
    | grep -qiE ":(wireguard|vpn|tun)$" && { echo "$dev"; return 0; }
  return 1
}

# Returns the portal's login URL on stdout, or nothing if we are actually online.
detect_url() {
  local code redirect body
  read -r code redirect < <(curl -sS -m 6 -o /tmp/.portal-body.$$ \
      -w '%{http_code} %{redirect_url}' "$NM_URI" 2>/dev/null || echo "000 ")
  body="$(cat /tmp/.portal-body.$$ 2>/dev/null)"; rm -f /tmp/.portal-body.$$
  case "$code" in
    30[0-9]) [[ -n "$redirect" ]] && { echo "$redirect"; return 0; } ;;
    200|204)
      # Some portals return 200 with their own page instead of redirecting.
      if [[ "$body" != *"NetworkManager is online"* && -n "$body" ]]; then
        echo "$NM_URI"; return 0
      fi
      return 1 ;;
    000) echo "$FALLBACK_URL"; return 0 ;;   # TLS/connect interference
  esac
  return 1
}

open_portal() {
  local ks
  if ! has_link; then
    echo "No network attached — nothing to sign in to."
    return 1
  fi
  if ks="$(killswitch_device)"; then
    notify-send -u critical -a "Portal" -i network-vpn \
      "Turn the VPN off to sign in" \
      "Run: omarchy-portal signin — drops the VPN, opens the login page, and reminds you to reconnect." 2>/dev/null
    echo "A VPN or kill switch holds the default route (via $ks)."
    echo "The login page cannot load until it is off."
    echo "Run:  omarchy-portal signin   (drops the VPN, opens the page, reconnects after)"
    return 2
  fi
  local url; url="$(detect_url)" || url=""
  if [[ -z "$url" ]]; then
    echo "No captive portal detected — connectivity is '$(state)'."
    return 1
  fi
  notify-send -a "Portal" -i network-wireless \
    "Wi-Fi needs you to sign in" "Opening the login page…" 2>/dev/null
  echo "Opening $url"
  xdg-open "$url" >/dev/null 2>&1 &
}

# The whole dance in one command, because doing it by hand at 11pm in a hotel
# is four steps in an order that is easy to get wrong.
signin() {
  local vpns
  vpns="$(nmcli -t -f NAME,TYPE connection show --active 2>/dev/null \
          | awk -F: '$2 ~ /wireguard|vpn|tun/ {print $1}')"
  if [[ -n "$vpns" ]]; then
    echo "Disconnecting VPN so the login page can load:"
    while IFS= read -r v; do
      [[ -z "$v" ]] && continue
      echo "  down: $v"
      nmcli connection down "$v" >/dev/null 2>&1
    done <<< "$vpns"
    sleep 2
  fi

  open_portal || true
  echo
  echo "Sign in, then bring the VPN back up:"
  while IFS= read -r v; do
    [[ -z "$v" ]] && continue
    echo "  omarchy-portal vpn-up   # or: nmcli connection up \"$v\""
  done <<< "$vpns"
  printf '%s\n' "$vpns" > "${XDG_RUNTIME_DIR:-/tmp}/omarchy-portal-vpn"
}

vpn_up() {
  local f="${XDG_RUNTIME_DIR:-/tmp}/omarchy-portal-vpn"
  [[ -s "$f" ]] || { echo "No VPN was taken down by Portal."; return 1; }
  while IFS= read -r v; do
    [[ -z "$v" ]] && continue
    echo "  up: $v"; nmcli connection up "$v" >/dev/null 2>&1
  done < "$f"
  rm -f "$f"
  notify-send -a "Portal" -i network-vpn "VPN reconnected" 2>/dev/null
}

case "${1:-open}" in
  open)   open_portal ;;
  signin) signin ;;
  vpn-up) vpn_up ;;
  status)
    echo "connectivity: $(state)"
    if ks="$(killswitch_device)"; then echo "vpn: holding the default route via $ks — sign-in will fail until it is off"
    else echo "vpn: not in the way"; fi
    u="$(detect_url)" && echo "portal: $u" || echo "portal: none" ;;
  url)    detect_url ;;
  *) echo "usage: omarchy-portal [open|signin|vpn-up|status|url]" >&2; exit 2 ;;
esac
